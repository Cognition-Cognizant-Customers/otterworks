# Local development overrides for docker-compose. Copy to .env and adjust as needed.
# The values here are the defaults baked into docker-compose.yml for local dev only.

# Seeded admin account for the web app login flow (see docs/local-dev-admin-seed.md).
AUTH_ADMIN_SEED_EMAIL=admin@otterworks.dev
AUTH_ADMIN_SEED_PASSWORD=Admin123!

JWT_SECRET=otterworks-local-dev-jwt-secret-change-me-in-production
