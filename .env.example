# Local development environment variables.
# Copy to .env (git-ignored) and adjust as needed; docker compose reads it automatically.
# Every value below is the local-dev default baked into docker-compose.yml, so
# `make up` works without a .env file. Never reuse these values outside local dev.

# Postgres credentials shared by the infra container and all services.
# Some services embed this in a connection URL, so keep it URL-safe
# (avoid @ : / ? # and spaces). Postgres only applies this at initdb, so once the
# stack has run, recreate the volume before changing it:
#   docker compose -f docker-compose.infra.yml -f docker-compose.yml down -v
POSTGRES_PASSWORD=otterworks_dev
