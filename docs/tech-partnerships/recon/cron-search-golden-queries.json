      "id": "DOC-UNICODE-TITLE",
      "collection": "documents",
      "intent": "A multi-byte title term must remain matchable after migration.",
      "meilisearch_query": {
        "q": "Δocument"
      },
      "atlas_pipeline": [
        {
          "$search": {
            "index": "default",
            "text": {
              "query": "Δocument",
              "path": [
                "title",
                "content",
                "tags"
              ]
            }
          }
        },
        {
          "$project": {
            "_id": 0,
            "id": 1
          }
        }
      ],
      "expected_count": 1,
      "expected_ids": [
        "doc-004"
      ]
    },
